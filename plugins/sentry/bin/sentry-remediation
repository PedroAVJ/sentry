#!/bin/sh
set -eu

script="$0"
while [ -L "$script" ]; do
  dir="$(CDPATH= cd -- "$(dirname -- "$script")" && pwd)"
  link="$(readlink "$script")"
  case "$link" in
    /*) script="$link" ;;
    *) script="$dir/$link" ;;
  esac
done

plugin_root="$(CDPATH= cd -- "$(dirname -- "$script")/.." && pwd)"
exec python3 "$plugin_root/scripts/sentry_remediation.py" "$@"
